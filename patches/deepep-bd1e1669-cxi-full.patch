diff --git a/deep_ep/include/deep_ep/common/cxi_packed_channel.cuh b/deep_ep/include/deep_ep/common/cxi_packed_channel.cuh
new file mode 100644
index 0000000..37a4a1d
--- /dev/null
+++ b/deep_ep/include/deep_ep/common/cxi_packed_channel.cuh
@@ -0,0 +1,14 @@
+#pragma once
+#ifdef __CUDACC__
+#define CXI_PACK_HD __host__ __device__
+#else
+#define CXI_PACK_HD
+#endif
+namespace deep_ep { namespace elastic {
+// Sum the actual capacities of preceding strided channels, without padding.
+CXI_PACK_HD constexpr int packed_channel_base(int max_tokens, int channels, int channel) {
+    return channel * (max_tokens / channels) +
+           (channel < max_tokens % channels ? channel : max_tokens % channels);
+}
+}}
+#undef CXI_PACK_HD
diff --git a/deep_ep/include/deep_ep/common/cxi_packed_combine.cuh b/deep_ep/include/deep_ep/common/cxi_packed_combine.cuh
new file mode 100644
index 0000000..cf83929
--- /dev/null
+++ b/deep_ep/include/deep_ep/common/cxi_packed_combine.cuh
@@ -0,0 +1,15 @@
+#pragma once
+#ifdef __CUDACC__
+#define CXI_PACKC_HD __host__ __device__
+#else
+#define CXI_PACKC_HD
+#endif
+namespace deep_ep { namespace elastic {
+// Channel-major slot of token `t` inside one scale-out receive layer. Bijective on
+// [0, max_tokens): channel c = t % channels owns slots [base(c), base(c) + count(c)).
+CXI_PACKC_HD constexpr int packed_combine_slot(int max_tokens, int channels, int t) {
+    const int c = t % channels;
+    return c * (max_tokens / channels) + (c < max_tokens % channels ? c : max_tokens % channels) + t / channels;
+}
+}}
+#undef CXI_PACKC_HD
