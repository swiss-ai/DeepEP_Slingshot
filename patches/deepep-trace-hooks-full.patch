diff -ruN '--exclude=.git' '--exclude=third-party' '--exclude=__pycache__' '--exclude=*.pyc' verify/csrc/elastic/host_trace.hpp trace/csrc/elastic/host_trace.hpp
--- a/csrc/elastic/host_trace.hpp	1970-01-01 01:00:00.000000000 +0100
+++ b/csrc/elastic/host_trace.hpp	2026-10-30 13:29:34.175870700 +0100
@@ -0,0 +1,15 @@
+#pragma once
+#include <time.h>
+#include <stdint.h>
+#include <vector>
+namespace ep_trace_host {
+struct Event {const char* name; uint64_t ns;};
+inline thread_local bool active=false;
+inline thread_local std::vector<Event> events;
+inline void mark(const char* name) {
+  if (!active) return;
+  timespec t; clock_gettime(CLOCK_MONOTONIC,&t);
+  events.push_back({name,uint64_t(t.tv_sec)*1000000000ULL+uint64_t(t.tv_nsec)});
+}
+inline void enable(bool value) {events.clear();events.reserve(256);active=value;}
+}
